# Where the Go agent-runtime service listens.
AGENT_RUNTIME_BASE_URL=http://localhost:8090

# API surface to call. `/internal` is a legacy alias and uses the same service
# auth middleware when AGENT_RUNTIME_SERVICE_TOKEN is set.
AGENT_RUNTIME_API_PREFIX=/v1

# Bearer token for the service API. Stays server-side (never bundled).
# AGENT_RUNTIME_SERVICE_TOKEN=

# Host application id every agent/run is scoped to.
AGENT_RUNTIME_APP_ID=host_app
