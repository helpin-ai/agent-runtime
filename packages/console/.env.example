# Where the Go agent-runtime service listens.
AGENT_RUNTIME_BASE_URL=http://localhost:8090

# API surface to call. `/internal` needs no auth (local dev). For any shared or
# deployed environment use `/v1` and set AGENT_RUNTIME_SERVICE_TOKEN.
AGENT_RUNTIME_API_PREFIX=/internal

# Bearer token for the /v1 service API. Stays server-side (never bundled).
# AGENT_RUNTIME_SERVICE_TOKEN=

# Host application id every agent/run is scoped to.
AGENT_RUNTIME_APP_ID=host_app
