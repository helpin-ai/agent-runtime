{
  "manifest_version": 3,
  "name": "Agent Runtime Browser (experimental)",
  "version": "0.3.0",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "runtime-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "keyboard.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
