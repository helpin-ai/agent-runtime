# Fully local LM Studio profile. No hosted credentials or paid endpoints.
AGENT_RUNTIME_MEMORY_BACKEND=sqlite
AGENT_RUNTIME_MEMORY_SQLITE_PATH=.local/memory/local-nomic-768.db
AGENT_RUNTIME_MEMORY_MODEL_URL=http://127.0.0.1:1234/v1
AGENT_RUNTIME_MEMORY_MODEL_API_KEY=local
AGENT_RUNTIME_MEMORY_EXTRACTION_MODEL=qwen/qwen3.6-35b-a3b
AGENT_RUNTIME_MEMORY_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
AGENT_RUNTIME_MEMORY_EMBEDDING_DIMENSIONS=768
AGENT_RUNTIME_MEMORY_MODEL_TIMEOUT=15m
AGENT_RUNTIME_MEMORY_CANDIDATE_LIMIT=1000
AGENT_RUNTIME_MEMORY_EXTRACTION_OPTIONS='{"max_tokens":8192,"temperature":0,"reasoning_effort":"none"}'
AGENT_RUNTIME_MEMORY_ANSWER_OPTIONS='{"max_tokens":2048,"temperature":0,"reasoning_effort":"none"}'
AGENT_RUNTIME_MEMORY_JUDGE_OPTIONS='{"max_tokens":4096,"temperature":0,"reasoning_effort":"high"}'
HINDSIGHT_API_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15438/postgres
HINDSIGHT_API_DATABASE_SCHEMA=parity_local_nomic768
