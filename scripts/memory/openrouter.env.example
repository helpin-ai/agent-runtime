# Keep OPENROUTER_API_KEY in your private environment, e.g. .env.pippi.
# Memory storage stays on this device; hosted inference receives ingested text.
AGENT_RUNTIME_MEMORY_BACKEND=sqlite
AGENT_RUNTIME_MEMORY_SQLITE_PATH=.local/memory/memory.db
AGENT_RUNTIME_MEMORY_MODEL_URL=https://openrouter.ai/api/v1
AGENT_RUNTIME_MEMORY_EXTRACTION_MODEL=openai/gpt-6-luna
AGENT_RUNTIME_MEMORY_EMBEDDING_MODEL=openai/text-embedding-3-small
AGENT_RUNTIME_MEMORY_EMBEDDING_DIMENSIONS=1536
AGENT_RUNTIME_MEMORY_EXTRACTION_OPTIONS='{"max_completion_tokens":16384,"reasoning_effort":"none"}'
AGENT_RUNTIME_MEMORY_MODEL_TIMEOUT=15m
AGENT_RUNTIME_MEMORY_CANDIDATE_LIMIT=1000
# Benchmark generation settings; runtime memory does not use these two fields.
AGENT_RUNTIME_MEMORY_ANSWER_OPTIONS='{"max_completion_tokens":4096,"reasoning_effort":"low"}'
AGENT_RUNTIME_MEMORY_JUDGE_OPTIONS='{"max_tokens":2048,"reasoning":{"enabled":false},"temperature":0}'
