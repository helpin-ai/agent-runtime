# Runtime host example. Copy to a private environment file and supply secrets.
# API and ALL workers need the same database, app config and encryption keys.
AGENT_RUNTIME_ADDR=127.0.0.1:8090
AGENT_RUNTIME_STORE_DRIVER=postgres
DATABASE_URL=postgres://runtime:replace-me@127.0.0.1:5432/agent_runtime?sslmode=disable
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
AGENT_RUNTIME_EVENT_SINK=log,nats
AGENT_RUNTIME_NATS_URL=nats://127.0.0.1:4222
AGENT_RUNTIME_SERVICE_TOKEN=
AGENT_RUNTIME_APP_CONFIG=@ops/examples/helpin-apps.yaml
# Stable base64 encoding of 32 random bytes, separate from Helpin's connection key.
AGENT_RUNTIME_MODEL_CREDENTIAL_ENCRYPTION_KEY=
# Independent run-MCP encryption key (also stable across API and workers).
AGENT_RUNTIME_MCP_CREDENTIAL_ENCRYPTION_KEY=
# Exactly Helpin INTERNAL_API_SECRET, not its runtime service token.
HELPIN_INTERNAL_API_SECRET=
# Opt in once subscription consent/refresh gates are validated in this deployment.
AGENT_RUNTIME_CHATGPT_ENABLED=false
# Optional existing standalone / Usermaven defaults. Strict Helpin cannot use them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Browser tools are app-scoped in AGENT_RUNTIME_APP_CONFIG. Kernel is optional;
# without it (or when its billing credit is unavailable), local Chromium runs.
AGENT_RUNTIME_BROWSER_ENABLED=false
AGENT_RUNTIME_BROWSER_CHROMIUM_EXECUTABLE=
KERNEL_API_KEY=
